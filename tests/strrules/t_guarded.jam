# New-style jamfile: interpreted definitions guarded by JAM_BUILTINS.
# Works on old jam (variable unset -> rules defined) and new jam
# (builtins provided -> definitions skipped).

if ! SplitStringsOnSpace in $(JAM_BUILTINS) {
  rule SplitStringsOnSpace # list
  {
    local ret = ;
    for s in $(1) {
      local split = [ MATCH ([^\ ])+\ +(.*) : $(s) ] ;
      if $(split) { ret += $(split[1]) $(split[2]) ; } else { ret += $(s) ; }
    }
    return $(ret) ;
  }
}

if ! AddEscapesToMakeJamValidForWrite in $(JAM_BUILTINS) {
  rule AddEscapesToMakeJamValidForWrite # list
  {
    local spec_sym = "\"\\" ;
    local ret = ;
    for s in $(1) {
      local match_str = ([^$(spec_sym)]*)([$(spec_sym)])(.*) ;
      local split = [ MATCH $(match_str) : $(s) ] ;
      if ! $(split) { ret += $(s) ; continue ; }

      local result = $(split[1]) ;
      while $(split[2]) {
        result += \\$(split[2]) ;
        split = [ MATCH $(match_str) : $(split[3]) ] ;
        result += $(split[1]) ;
      }
      ret += $(result:J) ;
    }
    return $(ret) ;
  }
}

rule SimplifyComposedPath
{
  local prefix = $(1) ;
  local suffix = $(2) ;
  local rest = [ MATCH "^\.\.\/(.*)" : $(suffix) ] ;
  while $(rest) && $(prefix) {
    suffix = $(rest) ;
    prefix = $(prefix:D) ;
    rest = [ MATCH "^\.\.\/(.*)" : $(suffix) ] ;
  }
  return $(prefix)/$(suffix) ;
}

if ! MakePathAbsolute in $(JAM_BUILTINS) {
  rule MakePathAbsolute prefix : suffix
  {
    switch $(suffix) {
      case ..* : return [ SimplifyComposedPath $(prefix) : $(suffix) ] ;
    }
    return $(suffix) ;
  }
}

if ! MakePathListAbsolute in $(JAM_BUILTINS) {
  rule MakePathListAbsolute prefix : suffixList
  {
    local result = ;
    local suffix = ;

    for suffix in $(suffixList) {
      result += [ MakePathAbsolute $(prefix) : $(suffix) ] ;
    }
    return $(result) ;
  }
}

include $(CORPUS) ;
